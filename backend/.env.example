# Required for hotspot analysis (sign up at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional free-tier API keys (leave blank to skip these sources)
FINNHUB_API_KEY=
NEWSAPI_KEY=

# SEC EDGAR requires a user-agent identifying your contact
SEC_USER_AGENT=YourName your.email@example.com

# Database (default: SQLite file in project root)
DATABASE_URL=sqlite:///./data.db

# Watchlist of tickers (comma-separated)
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,SPY,QQQ

# Scheduler intervals (minutes)
NEWS_FETCH_MINUTES=15
PRICE_FETCH_MINUTES=10
HOTSPOT_ANALYSIS_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
